<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Post-splash theme — empty parent so Compose's MaterialTheme owns all styling.
        Activities don't actually use this directly; it's the target the splash
        theme transitions to after the system splash dismisses.
    -->
    <style name="Theme.MyrecipeApp" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
        Cold-launch splash theme — applied to the launcher Activity. The system
        splash window (mandatory on Android 12+) is the FIRST half of a single
        merged splash: it paints the forest-green background + the brand badge
        (ic_splash_badge). The Compose BrandSplash then fades in over the exact
        same green with the exact same badge at the same spot, and animates the
        "MealTime" wordmark + tagline in beneath it — so the OS→Compose hand-off
        is invisible (no flash, no icon pop, no jump). Auto-dismisses on the
        first Compose frame; transitions to Theme.MyrecipeApp via postSplashScreenTheme.

        Android 12+ uses these attrs natively. Older versions get the same look
        via the AndroidX core-splashscreen back-compat shim.
    -->
    <style name="Theme.MealTime.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_badge</item>
        <item name="postSplashScreenTheme">@style/Theme.MyrecipeApp</item>
    </style>
</resources>
