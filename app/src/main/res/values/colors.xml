<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand colors used by XML resources (launcher icon, splash screen theme, etc.).
    Compose colors live in ui/theme/Color.kt and must be kept in sync with these.
-->
<resources>
    <!-- Primary brand color — used for splash background and adaptive icon background.
         Kept in exact sync with Compose ForestGreen (ui/theme/Color.kt) so the system
         splash and the Compose BrandSplash share one identical green (no flash/shift). -->
    <color name="forest_green">#2D5A4E</color>
    <!-- Cream — used for the adaptive icon foreground and splash icon -->
    <color name="linen">#FAF7F5</color>
    <!-- Status bar tint used during splash so the bar matches the brand background -->
    <color name="splash_status_bar">#2D5A4E</color>
    <!-- Dark-theme background — mirrors Compose's Midnight (Color.kt) so the system
         splash matches the dark UI that loads right after it. -->
    <color name="midnight">#1B1D21</color>
    <!-- Splash background — defaults to forest green, overridden to @color/midnight in
         values-night/ so dark-mode users don't get a bright green flash on cold launch. -->
    <color name="splash_background">@color/forest_green</color>
</resources>
