<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules (Android 6.0 - 11).
    The manifest sets android:allowBackup="false", so these rules are advisory only —
    they exist as defense in depth in case allowBackup is ever flipped. We exclude
    EVERYTHING by default; if anything ever needs to be backed up, opt-in explicitly.

    See: https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
