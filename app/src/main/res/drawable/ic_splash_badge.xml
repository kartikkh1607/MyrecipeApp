<?xml version="1.0" encoding="utf-8"?>
<!--
    System-splash icon: the MealTime brand badge — a white rounded square holding
    the forest-green utensil glyph. It is a static replica of the badge that the
    Compose BrandSplash shows at screen center, so the OS splash and BrandSplash
    read as ONE continuous splash: the OS paints this badge instantly, then
    BrandSplash fades the wordmark + tagline in beneath the same badge (no pop,
    no jump). Drawn on a 288dp canvas; the badge fills the central ~120dp so it
    renders at a size close to BrandSplash's 100dp badge. Colors are kept in sync
    with Compose (white badge, ForestGreen #2D5A4E glyph).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <!-- White rounded-square badge (120dp, ~35dp corners), centered. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M119,84 H169 A35,35 0 0 1 204,119 V169 A35,35 0 0 1 169,204 H119 A35,35 0 0 1 84,169 V119 A35,35 0 0 1 119,84 Z" />

    <!-- Forest-green utensil glyph (Material 'Restaurant'), scaled 2.5x and centered. -->
    <group
        android:translateX="114"
        android:translateY="114"
        android:scaleX="2.5"
        android:scaleY="2.5">
        <path
            android:fillColor="#2D5A4E"
            android:pathData="M8.1,13.34l2.83,-2.83L3.91,3.5c-1.56,1.56,-1.56,4.09,0,5.66L8.1,13.34zM14.88,11.53c1.53,0.71,3.68,0.21,5.27,-1.38c1.91,-1.91,2.28,-4.65,0.81,-6.12c-1.46,-1.46,-4.2,-1.1,-6.12,0.81c-1.59,1.59,-2.09,3.74,-1.38,5.27L3.7,19.87l1.41,1.41L12,14.41l6.88,6.88l1.41,-1.41L13.41,13L14.88,11.53z" />
    </group>
</vector>
