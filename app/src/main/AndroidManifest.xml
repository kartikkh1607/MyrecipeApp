<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- AdMob: required by Play Services Ads SDK to read the Advertising ID.
         You MUST disclose this in the Play Console "Data safety" form. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:name=".MyRecipeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyrecipeApp">

        <!-- AdMob App ID — supplied by the ${admobAppId} manifest placeholder
             (see app/build.gradle.kts). Defaults to Google's TEST App ID; the release
             build swaps in your production App ID from local.properties (admob.app.id).
             Get yours at: https://apps.admob.com/ -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Resolve manifest merger conflict between play-services-ads-lite
             (gma_ad_services_config) and play-services-measurement-api
             (ga_ad_services_config). Ads SDK config wins. -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MealTime.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: custom scheme. Works without domain ownership; suitable
                 for the in-app share sheet ("Share this recipe → mealtime://recipe/123"). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mealtime" android:host="recipe" />
            </intent-filter>

            <!-- Deep link: HTTPS. Currently UNVERIFIED — Android shows a chooser
                 dialog. To make Android open these URLs in the app automatically:
                   1. Buy/control mealtime.app (or change the host below to a domain
                      you own).
                   2. Generate the assetlinks.json fingerprint:
                        https://developers.google.com/digital-asset-links/tools/generator
                      using the upload + Play App Signing SHA-256 from
                      project_signing_certs.
                   3. Host it at https://<domain>/.well-known/assetlinks.json
                   4. Flip android:autoVerify below to "true".
                 Until then, leave autoVerify off — turning it on without a hosted
                 assetlinks file will silently strip the filter on install. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="mealtime.app"
                    android:pathPrefix="/recipe/" />
            </intent-filter>
        </activity>
    </application>

</manifest>